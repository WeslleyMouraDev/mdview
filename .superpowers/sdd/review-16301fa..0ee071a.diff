++++'use client';
++++
++++import { useEffect } from 'react';
++++import styles from './Toast.module.css';
++++
++++export default function Toast({ message, type = 'info', onClose, duration = 3000 }) {
++++  useEffect(() => {
++++    const timer = setTimeout(onClose, duration);
++++    return () => clearTimeout(timer);
++++  }, [onClose, duration]);
